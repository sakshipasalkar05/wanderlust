<style>
    .flash-alert {
        max-width: 40rem;
        margin: 1rem auto 0;
        border: none;
        border-radius: var(--radius-input);
        box-shadow: var(--shadow-soft);
        font-weight: 600;
    }

    .flash-alert.alert-success {
        background-color: #e8f7ee;
        color: #146c43;
    }

    .flash-alert.alert-danger {
        background-color: #fdecee;
        color: #b02a37;
    }
</style>

<% if (success && success.length) { %>
<div class="alert alert-success alert-dismissible fade show flash-alert" role="alert" data-autohide="1000">
    <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>

<% if (error && error.length) { %>
<div class="alert alert-danger alert-dismissible fade show flash-alert" role="alert" data-autohide="4000">
    <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>