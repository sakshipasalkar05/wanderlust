<style>
  .site-nav.navbar {
    height: auto;
    min-height: 4.5rem;
    background-color: white;
    border-bottom: 1px solid #ebebeb;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  }

  .site-nav .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    font-size: 1.4rem;
    color: var(--brand);
  }

  .site-nav .nav-link {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .site-nav .nav-link:hover {
    color: var(--brand) !important;
  }

  .site-nav .nav-search {
    width: 100%;
    max-width: 26rem;
  }

  .site-nav .search-inp {
    border-radius: 2rem;
    padding: 0.5rem 1.25rem;
    font-size: 0.95rem;
  }

  .site-nav .btn {
    padding: 0.45rem 1.1rem;
    font-size: 0.9rem;
  }

  .site-nav .search-btn i {
    margin-right: 0.4rem;
  }
</style>

<% const navLoggedIn = typeof currUser !== 'undefined' && currUser; %>

<nav class="navbar navbar-expand-md sticky-top site-nav">
  <div class="container-fluid">
    <a class="navbar-brand brand-logo" href="/listings">
      <i class="fa-solid fa-compass"></i> Wanderlust
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">

      <form class="d-flex gap-2 nav-search mx-md-auto my-2 my-md-0" role="search" action="/listings" method="GET">
        <input class="form-control search-inp" type="search" name="q" placeholder="Search destinations" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" />
        <button class="btn btn-brand search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
      </form>

      <div class="navbar-nav align-items-md-center gap-md-2">
        <a class="nav-link" href="/listings/new">Host on Wanderlust</a>

        <% if (!navLoggedIn) { %>
          <div class="d-flex gap-2 mt-2 mt-md-0">
            <a class="btn btn-brand-outline" href="/login">Log in</a>
            <a class="btn btn-brand" href="/signup">Sign up</a>
          </div>
        <% } else { %>
          <a class="nav-link" href="/wishlist">Wishlist</a>
          <form action="/logout" method="POST" class="mt-2 mt-md-0">
            <button type="submit" class="btn btn-brand-outline">Logout</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</nav>