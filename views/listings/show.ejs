<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<%
const loggedIn = typeof currUser !== 'undefined' && currUser;
const isListingOwner = loggedIn && listing.owner && listing.owner._id.equals(currUser._id);
const hasReviewed = loggedIn && listing.reviews.some(r => r.author && r.author._id.equals(currUser._id));
const isSaved = loggedIn && currUser.wishlist.some(w => w.equals(listing._id));
%>

<div class="row mt-3">
    <div class="col-12 col-md-8 col-lg-6 offset-md-2 offset-lg-3">
        <h3><%= listing.title %></h3>
        <% if (listing.reviews.length > 0) { %>
            <div class="d-flex align-items-center gap-2">
                <p class="starability-result m-0" data-rating="<%= Math.round(avgRating) %>"></p>
                <span><%= avgRating.toFixed(1) %> &middot; <%= listing.reviews.length %> review<%= listing.reviews.length === 1 ? "" : "s" %></span>
            </div>
        <% } else { %>
            <p class="text-muted">No reviews yet</p>
        <% } %>
    </div>

    <div class="card col-12 col-md-8 col-lg-6 offset-md-2 offset-lg-3 show-card listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">

        <% if (loggedIn) { %>
            <form method="POST" action="/listings/<%= listing._id %>/wishlist" class="mt-2">
                <button type="submit" class="btn btn-sm btn-outline-dark">
                    <i class="<%= isSaved ? 'fa-solid' : 'fa-regular' %> fa-heart" style="color: #fe424d;"></i>
                    <%= isSaved ? 'Saved' : 'Save' %>
                </button>
            </form>
        <% } else { %>
            <a href="/login" class="btn btn-sm btn-outline-dark mt-2">
                <i class="fa-regular fa-heart" style="color: #fe424d;"></i> Save
            </a>
        <% } %>

        <div class="card-body">
            <p class="card-text">Owned by: <i><%= listing.owner ? listing.owner.username : "Unknown" %></i></p>
            <p><%= listing.description %></p>
            <p>&#8377;<%= listing.price.toLocaleString("en-IN") %></p>
            <p><%= listing.location %></p>
            <p><%= listing.country %></p>
        </div>
    </div>

    <% if (isListingOwner) { %>
        <div class="col-12 col-md-8 col-lg-6 offset-md-2 offset-lg-3 mb-3 d-flex gap-2">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">Edit</a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn btn-dark">Delete</button>
            </form>
        </div>
    <% } %>

    <div class="col-12 col-md-8 col-lg-6 offset-md-2 offset-lg-3 mb-3">
        <% if (loggedIn && !isListingOwner && !hasReviewed) { %>
            <hr>
            <h4>Leave a Review</h4>
            <form action="/listings/<%= listing.id %>/reviews" method="post" novalidate class="needs-validation">
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>

                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please add some comments for review</div>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
        <% } %>

        <% if (listing.reviews.length > 0) { %>
            <hr>
            <p><b>All Reviews</b></p>
            <% for (let review of listing.reviews) { %>
                <div class="card mb-3">
                    <div class="card-body p-3">
                        <h5 class="card-title">@<%= review.author ? review.author.username : "deleted user" %></h5>
                        <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                        <p class="card-text"><%= review.comment %></p>

                        <% if (loggedIn && review.author && review.author._id.equals(currUser._id)) { %>
                            <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                <button class="btn btn-sm btn-dark">Delete</button>
                            </form>
                        <% } %>
                    </div>
                </div>
            <% } %>
        <% } %>
    </div>
</div>