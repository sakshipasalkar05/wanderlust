<% layout("/layouts/boilerplate") %>
<!-- Leaflet: reserved for the map feature, not used yet -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
    .show-meta {
        color: var(--muted);
        font-size: 0.95rem;
    }

    .show-badge {
        background: var(--soft);
        color: var(--ink);
        font-weight: 600;
        font-size: 0.8rem;
        padding: 0.3rem 0.8rem;
        border-radius: 2rem;
    }

    .show-hero {
        border-radius: var(--radius-card);
        overflow: hidden;
        aspect-ratio: 16 / 10;
        background: var(--soft);
    }

    .show-hero img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .avatar {
        flex: 0 0 auto;
        width: 2.6rem;
        height: 2.6rem;
        border-radius: 50%;
        background: var(--brand);
        color: white;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .side-card {
        position: sticky;
        top: 6rem;
    }

    .side-price {
        font-size: 1.6rem;
        font-weight: 800;
    }

    .review-card {
        border: 1px solid #ebebeb;
        border-radius: var(--radius-card);
        padding: 1rem 1.25rem;
        margin-bottom: 1rem;
    }
    #map {
        height: 22rem;
        border-radius: var(--radius-card);
        z-index: 0; /* keeps the map's layers from covering the navbar */
    }  
</style>

<%
const loggedIn = typeof currUser !== 'undefined' && currUser;
const isListingOwner = loggedIn && listing.owner && listing.owner._id.equals(currUser._id);
const hasReviewed = loggedIn && listing.reviews.some(r => r.author && r.author._id.equals(currUser._id));
const isSaved = loggedIn && currUser.wishlist.some(w => w.equals(listing._id));
const ownerName = listing.owner ? listing.owner.username : "Unknown";
%>

<!-- Title row -->
<div class="mt-4">
    <h3 class="page-title"><%= listing.title %></h3>
    <div class="show-meta d-flex flex-wrap align-items-center gap-2 gap-md-3">
        <% if (listing.reviews.length > 0) { %>
            <div class="d-flex align-items-center gap-2">
                <p class="starability-result m-0" data-rating="<%= Math.round(avgRating) %>"></p>
                <span><%= avgRating.toFixed(1) %> &middot; <%= listing.reviews.length %> review<%= listing.reviews.length === 1 ? "" : "s" %></span>
            </div>
        <% } else { %>
            <span>No reviews yet</span>
        <% } %>
        <span><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></span>
        <% if (listing.category) { %>
            <span class="show-badge"><%= listing.category %></span>
        <% } %>
    </div>
</div>

<!-- Photo + details | price card -->
<div class="row mt-3 g-4">
    <div class="col-12 col-lg-8">
        <div class="show-hero">
            <img src="<%= listing.image.url %>" alt="<%= listing.title %>">
        </div>

        <div class="d-flex align-items-center gap-3 mt-4">
            <div class="avatar"><%= ownerName.charAt(0).toUpperCase() %></div>
            <div class="fw-bold">Hosted by <%= ownerName %></div>
        </div>

        <hr>
        <h5>About this place</h5>
        <p style="white-space: pre-line;"><%= listing.description %></p>

        <!-- MAP -->
        <% const hasMap = listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2; %>
        <% if (hasMap) { %>
            <hr>
            <h5>Where you'll be</h5>
            <p class="text-muted mb-2"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p>
            <div id="map"
                 data-lng="<%= listing.geometry.coordinates[0] %>"
                 data-lat="<%= listing.geometry.coordinates[1] %>"
                 data-title="<%= listing.title %>"></div>
            <p class="text-muted small mt-2">Approximate location, based on the place name.</p>
        <% } %>
    </div>

    <div class="col-12 col-lg-4">
        <div class="page-card side-card">
            <div class="side-price">
                &#8377;<%= listing.price.toLocaleString("en-IN") %>
                <small class="fw-normal fs-6 text-muted">/ night</small>
            </div>
            <div class="text-muted small mb-3">
                &#8377;<%= Math.round(listing.price * 1.18).toLocaleString("en-IN") %> / night incl. 18% GST
            </div>

            <% if (loggedIn) { %>
                <form method="POST" action="/listings/<%= listing._id %>/wishlist">
                    <button type="submit" class="btn btn-brand-outline w-100">
                        <i class="<%= isSaved ? 'fa-solid' : 'fa-regular' %> fa-heart" style="color: #fe424d;"></i>
                        <%= isSaved ? 'Saved to wishlist' : 'Save to wishlist' %>
                    </button>
                </form>
            <% } else { %>
                <a href="/login" class="btn btn-brand-outline w-100">
                    <i class="fa-regular fa-heart" style="color: #fe424d;"></i> Log in to save
                </a>
            <% } %>

            <% if (isListingOwner) { %>
                <hr>
                <div class="d-flex gap-2">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-brand flex-fill">Edit</a>
                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="flex-fill" data-confirm="Delete this listing? This can't be undone.">
                        <button class="btn btn-brand-outline w-100">Delete</button>
                    </form>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Reviews -->
<div class="row mt-4 mb-5">
    <div class="col-12 col-lg-8">
        <hr>

        <% if (loggedIn && !isListingOwner && !hasReviewed) { %>
            <h4>Leave a review</h4>
            <form action="/listings/<%= listing.id %>/reviews" method="post" novalidate class="needs-validation mb-4">
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>

                <div class="mb-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comment" rows="4" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please add some comments for your review</div>
                </div>
                <button class="btn btn-brand">Submit review</button>
            </form>
        <% } %>

        <% if (listing.reviews.length > 0) { %>
            <h4 class="mb-3">All reviews</h4>
            <% for (let review of listing.reviews) { %>
                <%
                const authorName = review.author ? review.author.username : "deleted user";
                const isMine = loggedIn && review.author && review.author._id.equals(currUser._id);
                %>
                <div class="review-card">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="avatar"><%= authorName.charAt(0).toUpperCase() %></div>
                        <div>
                            <div class="fw-bold">@<%= authorName %></div>
                            <% if (review.createdAt) { %>
                                <div class="text-muted small"><%= review.createdAt.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %></div>
                            <% } %>
                        </div>
                    </div>

                    <p class="starability-result" data-rating="<%= review.rating %>"></p>
                    <p class="mb-2"><%= review.comment %></p>

                    <% if (isMine) { %>
                        <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" data-confirm="Delete your review?">
                            <button class="btn btn-sm btn-brand-outline">Delete</button>
                        </form>
                    <% } %>
                </div>
            <% } %>
        <% } %>
    </div>
</div>

<script>
    // Ask before any form marked with data-confirm is submitted
    document.querySelectorAll("form[data-confirm]").forEach(form => {
        form.addEventListener("submit", event => {
            if (!confirm(form.dataset.confirm)) {
                event.preventDefault();
            }
        });
    });
</script>

<script>
    const mapEl = document.getElementById("map");

    if (mapEl && window.L) {
        const lat = parseFloat(mapEl.dataset.lat);
        const lng = parseFloat(mapEl.dataset.lng);

        if (!Number.isNaN(lat) && !Number.isNaN(lng)) {
            // Leaflet wants [latitude, longitude], but the database stores
            // [longitude, latitude], so the two are flipped here
            const map = L.map("map").setView([lat, lng], 12);

            L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            }).addTo(map);

            // Build the popup as a text node, so a title can never inject HTML
            const popup = document.createElement("b");
            popup.textContent = mapEl.dataset.title;
            L.marker([lat, lng]).addTo(map).bindPopup(popup);
        }
    }
</script>