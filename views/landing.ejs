<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust - Find your next stay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: "Plus Jakarta Sans", sans-serif;
            margin: 0;
        }

        .cover {
            min-height: 100vh;
            background:
                linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.6)),
                url("https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1600&q=60")
                center / cover no-repeat;
            color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 2rem;
        }

        .cover .brand-icon {
            font-size: 3.5rem;
            color: #fe424d;
        }

        .cover h1 {
            font-weight: 800;
            font-size: clamp(2.5rem, 7vw, 4.5rem);
            margin-top: 0.5rem;
        }

        .cover p.tagline {
            font-size: clamp(1rem, 2.5vw, 1.35rem);
            font-weight: 300;
            max-width: 36rem;
            margin: 0.5rem auto 2rem;
        }

        .btn-signup {
            background-color: #fe424d;
            border: none;
            color: white;
            padding: 0.75rem 2rem;
            font-weight: 600;
            border-radius: 2rem;
        }

        .btn-signup:hover {
            background-color: #e0343f;
            color: white;
        }

        .btn-login {
            border: 2px solid white;
            color: white;
            padding: 0.75rem 2rem;
            font-weight: 600;
            border-radius: 2rem;
        }

        .btn-login:hover {
            background-color: white;
            color: #222222;
        }

        .guest-link {
            color: rgba(255, 255, 255, 0.85);
            text-decoration: none;
            font-size: 0.95rem;
        }

        .guest-link:hover {
            color: white;
            text-decoration: underline;
        }

        .cover-flash {
            position: fixed;
            top: 1.5rem;
            left: 50%;
            transform: translateX(-50%);
            width: max-content;
            max-width: 90%;
            border: none;
            border-radius: 0.75rem;
            font-weight: 600;
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.25);
            z-index: 10;
        }
    </style>
</head>
<body>
    <div class="cover">
        <% if (success && success.length) { %>
            <div class="alert alert-success cover-flash" role="alert" data-autohide="4000"><%= success %></div>
        <% } %>
        <% if (error && error.length) { %>
            <div class="alert alert-danger cover-flash" role="alert" data-autohide="6000"><%= error %></div>
        <% } %>

        <i class="fa-solid fa-compass brand-icon"></i>
        <h1>Wanderlust</h1>
        <p class="tagline">Discover unique stays, from beachfront cottages to mountain cabins, and host your own place.</p>

        <div class="d-flex flex-wrap justify-content-center gap-3 mb-4">
            <a href="/signup" class="btn btn-signup">Sign up</a>
            <a href="/login" class="btn btn-login">Log in</a>
        </div>

        <a href="/listings" class="guest-link">Just browsing? Explore listings <i class="fa-solid fa-arrow-right"></i></a>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>